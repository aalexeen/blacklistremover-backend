# .env.example - Template for environment variables
# Copy this file to .env or application-local.yml and fill in your actual values
# DO NOT COMMIT .env or application-local.yml files!

# WLC SSH Configuration
WLC_USERNAME=your_wlc_username
WLC_PASSWORD=your_ssh_password
WLC_ENABLE_PASSWORD=your_enable_password

# Optional: Override default hosts/ports
WLC1_SSH_HOST=10.10.10.10
WLC1_SSH_PORT=22
WLC2_SSH_HOST=10.10.10.11
WLC2_SSH_PORT=22

# Optional: Override timeouts
WLC_CONNECTION_TIMEOUT=30
WLC_COMMAND_TIMEOUT=15
WLC_HEALTH_CHECK_INTERVAL=30

# Database Configuration
DB_URL=jdbc:postgresql://your_host:5432/your_database
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password